android_app {
    name: "DcDimming",
    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: [
        "src/**/*.java"
    ],

    certificate: "platform",
    resource_dirs: ["res"],
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "org.lineageos.settings.resources",
        "vendor.xiaomi.hardware.displayfeature-V2-java"
    ],

    required: [
        "privapp_whitelist_com.android.dcdimming.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.android.dcdimming.xml",
    src: "permissions/privapp_whitelist_com.android.dcdimming.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
