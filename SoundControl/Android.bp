android_app {
    name: "SoundControl",
    init_rc: ["init/init.soundcontrol.rc"],
    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: [
        "src/**/*.java"
    ],

    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
        "SettingsLib",
    ],

    required: [
        "privapp_whitelist_com.android.soundcontrol.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.android.soundcontrol.xml",
    src: "permissions/privapp_whitelist_com.android.soundcontrol.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
